{
	"name": "megadex",
	"version": "0.1.0-alpha.1",
	"description": "Megadex user management service.",
	"keywords": [
		"user-profile",
		"preferences",
		"reference-data",
		"express"
	],
	"main": "src/server.js",
	"type": "module",
	"scripts": {
		"start": "node src/server.js",
		"dev": "node --watch src/server.js",
		"test": "NODE_OPTIONS='--experimental-vm-modules' jest",
		"test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
		"test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
		"lint": "biome check src/ tests/",
		"lint:fix": "biome check --write src/ tests/",
		"format": "biome format src/ tests/",
		"format:fix": "biome format --write src/ tests/"
	},
	"author": "ALTEN",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ALTEN-group/Megadex.git"
	},
	"bugs": {
		"url": "https://github.com/ALTEN-group/Megadex/issues"
	},
	"homepage": "https://github.com/ALTEN-group/Megadex#readme",
	"dependencies": {
		"@dwtechs/antity-pgsql": "0.26.0",
		"@dwtechs/checkard": "3.7.0",
		"@dwtechs/errandler-express": "0.1.1",
		"@dwtechs/gatelin-express": "0.4.0",
		"@dwtechs/healix-express": "0.2.0",
		"@dwtechs/servpico-express": "0.3.1",
		"@dwtechs/sparray": "0.2.1",
		"@dwtechs/winstan": "0.7.1",
		"@dwtechs/winstan-plugin-express-perf": "0.3.0",
		"express": "5.2.1"
	},
	"devDependencies": {
		"@babel/core": "7.29.7",
		"@babel/preset-env": "7.29.7",
		"@biomejs/biome": "2.5.8",
		"@types/jest": "30.0.0",
		"@types/node": "26.2.0",
		"babel-jest": "30.4.1",
		"jest": "30.4.2",
		"supertest": "7.2.2"
	}
}
