ARG LIQUIBASE_VERSION=4.28.0-alpine
FROM liquibase/liquibase:${LIQUIBASE_VERSION}

LABEL org.opencontainers.image.description="Megadex database migrations (Liquibase)"

USER root

RUN apk update && apk add --no-cache postgresql-client curl

USER liquibase

# Owned by root with no write bit for group/other so the non-root
# liquibase user (running at container start) can read/execute but not modify it.
COPY --chown=root:root --chmod=755 ./entrypoint.sh /docker-entrypoint.sh

# Bake the Megadex schema changelog into the image
COPY --chown=liquibase:liquibase ./megadex /liquibase/changelog

# Optional user data volume (mount a data/changelog.xml at runtime)
VOLUME ["/liquibase/data"]

ENTRYPOINT ["/docker-entrypoint.sh"]
