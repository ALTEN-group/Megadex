{
  "javascript.preferences.importModuleSpecifier": "non-relative",
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "[scss]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never"
    }
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always"
    }
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true
  },
  "workbench.colorCustomizations": {
    "statusBar.noFolderBackground": "#7C21D7",
    "statussBar.prominentBackground": "#7C21D7",
    "activityBar.activeBackground": "#6366f1",
    "activityBar.background": "#6366f1",
    "activityBar.foreground": "#e7e7e7",
    "activityBar.inactiveForeground": "#e7e7e799",
    "activityBarBadge.background": "#22d3ee",
    "activityBarBadge.foreground": "#15202b",
    "commandCenter.border": "#e7e7e799",
    "sash.hoverBorder": "#6366f1",
    "statusBar.background": "#4f46e5",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#6366f1",
    "statusBarItem.remoteBackground": "#312e81",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#4f46e5",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#4f46e599",
    "titleBar.inactiveForeground": "#e7e7e799",
    "activityBarTop.activeBackground": "#6366f1",
    "activityBarTop.background": "#6366f1",
    "activityBarTop.foreground": "#e7e7e7",
    "activityBarTop.inactiveForeground": "#e7e7e799",
    "commandCenter.foreground": "#e7e7e7",
    "statusBar.debuggingBackground": "#4f46e5",
    "statusBar.debuggingForeground": "#e7e7e7",
    "activityBar.activeBorder": "#e7e7e7",
    "activityBarTop.activeBorder": "#e7e7e7",
    "statusBar.inactiveBackground": "#4f46e5"
  },
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "editor.detectIndentation": false,
  "peacock.remoteColor": "#4f46e5",
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Use conventional commit format: type(scope): description"
    },
    {
      "text": "Use imperative mood: 'Add feature' not 'Added feature'"
    },
    {
      "text": "Use types: feat, fix, docs, style, refactor, perf, test, chore, ci."
    },
    {
      "text": "Include scope when relevant (e.g., api, ui, auth)"
    },
    {
      "text": "Keep subject line under 50 characters"
    }
  ],
  "editor.indentSize": 2
}
