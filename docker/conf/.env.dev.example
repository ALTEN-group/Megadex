APP_NAME=megadex
NODE_VERSION=24.15.0-alpine3.22
NODE_ENV=development
TZ=Europe/Paris
UID=1000
GID=1000
# Used as a Docker build arg (glibc/musl locale). Blank is fine; C.UTF-8 is a safe default.
LOCALE=C.UTF-8
HOME_PATH=/home/user/

ENV_NAME=local
DEFAULT_PORT=3000
SERVER_SCHEME=http://
SERVER_URL=localhost
STACK_NAME=${APP_NAME}-${ENV_NAME}

# Declared after ENV_NAME: env-file interpolation is top-down.
# Must match Gatelin's proxy DNS: `${APP_NAME}-${service.name}-${ENV_NAME}`
# (service rows `megadex` / `foxnox`).
MEGADEX_HOST=${APP_NAME}-megadex-${ENV_NAME}
FOXNOX_HOST=${APP_NAME}-foxnox-${ENV_NAME}
GATELIN_HOST=${APP_NAME}-gatelin-${ENV_NAME}

# Adminer
ADMINER_HOST=${APP_NAME}-adminer-${ENV_NAME}
ADMINER_VERSION=adminer:latest
ADMINER_PORT=8080

# Liquibase
LIQUIBASE_VERSION=4.28.0-alpine
LIQUIBASE_DB_USER=liquibase
LIQUIBASE_DB_PWD=
LIQUIBASE_LOG_LEVEL=INFO
LIQUIBASE_UPDATE=1
LIQUIBASE_SNAPSHOT=1
LIQUIBASE_COMMAND_CONTEXTS=v1
LIQUIBASE_ROLLBACK=0

# Postgres
POSTGRES_HOST=${APP_NAME}-postgres-${ENV_NAME}
POSTGRES_VERSION=postgres:16.2-alpine3.19
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5432
POSTGRES_ROOT_USER=root
POSTGRES_ROOT_PWD=
POSTGRES_DBS=liquibase,gatelin,foxnox,megadex

#TRAEFIK
TRAEFIK_HOST=${APP_NAME}-traefik-${ENV_NAME}
TRAEFIK_VERSION=3.6.4
TRAEFIK_ACCESSLOG=true
TRAEFIK_API_INSECURE=true
TRAEFIK_ENTRYPOINTS_WEB_ADDRESS=":80"
TRAEFIK_ENTRYPOINTS_WEB_FORWARDEDHEADERS_INSECURE=false
TRAEFIK_PROVIDERS_DOCKER_EXPOSEDBYDEFAULT=false
TRAEFIK_LOG_LEVEL="DEBUG"
TRAEFIK_PING=true
TRAEFIK_DASH_PORT=8083
TRAEFIK_PORT=8100
TRAEFIK_PREFIX=/api
TRAEFIK_PUBLIC_URL=${SERVER_SCHEME}${SERVER_URL}:${TRAEFIK_PORT}${TRAEFIK_PREFIX}/

# Gatelin (BFF: sessions, ACL, proxy to megadex)
GATELIN_VERSION=0.1.0-alpha.11
GATELIN_DB_NAME=gatelin
GATELIN_DB_USER=
GATELIN_DB_PWD=
GATELIN_DB_JOB_USER=
GATELIN_DB_JOB_PWD=
GATELIN_TOKEN_SECRET=
GATELIN_PWD_CHECK_URL=${SERVER_SCHEME}${FOXNOX_HOST}:${DEFAULT_PORT}/foxnox/pwd/compare
GATELIN_PWD_CHALLENGES_URL=${SERVER_SCHEME}${FOXNOX_HOST}:${DEFAULT_PORT}/foxnox/challenges
GATELIN_PWD_TRUSTED_DEVICES_URL=${SERVER_SCHEME}${FOXNOX_HOST}:${DEFAULT_PORT}/foxnox/devices/verify
GATELIN_PWD_LOGIN_TICKET_URL=${SERVER_SCHEME}${FOXNOX_HOST}:${DEFAULT_PORT}/foxnox/login-tickets/redeem
GATELIN_ACCESS_TOKEN_DURATION=600 #10 * 60 => 10 mins
GATELIN_REFRESH_TOKEN_DURATION=86400 #24 * 60 * 60 => 1 day
GATELIN_REFRESH_TOKEN_COOKIE=true
GATELIN_MIGRATION_SERVICE_NAME=gatelin-migration
GATELIN_MIGRATION_HOST=${APP_NAME}-${GATELIN_MIGRATION_SERVICE_NAME}-${ENV_NAME}
# The gatelin image bundles its Angular admin UI but only starts it when ADMIN_PORT is set.
GATELIN_ADMIN_PORT=4300
GATELIN_ADMIN_BASE_PATH=/gatelin
GATELIN_ADMIN_PASSWORD_RECOVERY_URL=/api/foxnox/web/recover

# Foxnox (password service). Latest image published on ghcr.
FOXNOX_VERSION=0.1.0-alpha.5
FOXNOX_DB_NAME=foxnox
FOXNOX_DB_USER=
FOXNOX_DB_PWD=
FOXNOX_DB_JOB_USER=
FOXNOX_DB_JOB_PWD=
FOXNOX_PWD_SECRET=
FOXNOX_ACCESS_TOKEN_DURATION=600 #10 * 60 => 10 mins
FOXNOX_REFRESH_TOKEN_DURATION=86400 #24 * 60 * 60 => 1 day
FOXNOX_MIGRATION_SERVICE_NAME=foxnox-migration
FOXNOX_MIGRATION_HOST=${APP_NAME}-${FOXNOX_MIGRATION_SERVICE_NAME}-${ENV_NAME}
FOXNOX_ADMIN_PORT=4400
FOXNOX_ADMIN_BASE_PATH=/foxnox

# Outbound mail (Mailpit in local Docker)
MAILPIT_HOST=${APP_NAME}-mailpit-${ENV_NAME}
MAILPIT_VERSION=latest
MAILPIT_UI_PORT=8025
SMTP_HOST=${MAILPIT_HOST}
SMTP_PORT=1025
SMTP_SECURE=false
# Quoted: scripts source this file, and bare <> would be shell redirections.
SMTP_FROM="Megadex <noreply@localhost>"

# Megadex
MEGADEX_DB_NAME=megadex
MEGADEX_DB_USER=
MEGADEX_DB_PWD=
MEGADEX_DB_JOB_USER=
MEGADEX_DB_JOB_PWD=
MEGADEX_MIGRATION_SERVICE_NAME=${APP_NAME}-migration
MEGADEX_MIGRATION_HOST=${APP_NAME}-${MEGADEX_MIGRATION_SERVICE_NAME}-${ENV_NAME}
# User lookup used by Gatelin (login) and Foxnox (workflows)
MEGADEX_USER_SEARCH_URL=${SERVER_SCHEME}${MEGADEX_HOST}:${DEFAULT_PORT}/megadex/users/search
# Foxnox credential provisioning called when creating users in Megadex
MEGADEX_PWD_CREATE_URL=${SERVER_SCHEME}${FOXNOX_HOST}:${DEFAULT_PORT}/foxnox/pwd

# Swagger
SWAGGER_HOST=${APP_NAME}-swagger-${ENV_NAME}

# Website (docs)
WEBSITE_HOST=${APP_NAME}-website-${ENV_NAME}

# Admin
ADMIN_HOST=${APP_NAME}-admin-${ENV_NAME}
ADMIN_PORT=4200
ADMIN_NODE_VERSION=${NODE_VERSION}
ADMIN_URL=${SERVER_SCHEME}${ADMIN_HOST}:${ADMIN_PORT}/megadex/
# Optional. localStorage key for the access token (default: sso_access_token).
# Shared with the Gatelin and Foxnox admins so one login covers the three UIs.
ADMIN_SSO_TOKEN_KEY=megadex_sso_access_token
# Optional. Gatelin "search roles" route the admin calls to fill the roles
# multiselect on user profiles (default: /api/gatelin/roles/search).
ADMIN_ROLES_SEARCH_URL=/api/gatelin/roles/search

# Admin E2E (Playwright, on-demand via `scripts/e2e.sh` or the `e2e` compose profile).
# Pin PLAYWRIGHT_VERSION to whatever admin/package.json's @playwright/test resolves to;
# the container image tag is mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble.
PLAYWRIGHT_VERSION=1.62.1
ADMIN_E2E_HOST=${APP_NAME}-admin-e2e-${ENV_NAME}
# URL the e2e container polls + Playwright uses as baseURL. Points at Traefik
# on the internal network (port 80 is Traefik's default web entrypoint),
# so tests exercise the same routing path a real browser hits.
ADMIN_E2E_BASE_URL=http://traefik/megadex/
# Authenticated specs are skipped unless E2E_PASSWORD is set.
# Filled by scripts/setup-mocks.sh.
E2E_EMAIL=
E2E_PASSWORD=

#npm registry
NPM_REGISTRY_DOMAIN=
NPM_REGISTRY_NODE=
NPM_REGISTRY_USER=
NPM_REGISTRY_TOKEN=
NPM_REGISTRY_URL=
NPMRC=""
